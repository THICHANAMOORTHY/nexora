# 1. Backend Express API Base URL (must end with /api)
# Local Development:
VITE_API_URL=http://localhost:5000/api
# Production Example (Vercel / Netlify deployment):
# VITE_API_URL=https://your-backend-domain.onrender.com/api

# 2. Supabase Configuration (Realtime Project Sync & Auth)
VITE_SUPABASE_URL=https://wlwlpkizjxtbgjiwmpdk.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
