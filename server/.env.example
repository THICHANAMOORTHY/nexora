# Server Port
PORT=5000

# MongoDB Database Connection URI
# Option 1: Local MongoDB (Default)
MONGODB_URI=mongodb://127.0.0.1:27017/nexora_tech

# Option 2: Cloud MongoDB Atlas (Free Cluster)
# Replace with your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nexora_tech?retryWrites=true&w=majority
